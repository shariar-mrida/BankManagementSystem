{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/database/(.*)",
      "dest": "/database/$1"
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/tables",
      "dest": "/tables.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}